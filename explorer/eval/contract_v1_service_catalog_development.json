          {
            "op": "call",
            "target": "Light.MoveToColor",
            "args": {
              "TransitionTime": 3,
              "ColorY": 0.2,
              "ColorX": 0.1
            }
          }
        ]
      },
      "joi_block": {
        "script": "(#Light).light_moveToColor(0.1, 0.2, 3)",
        "period": 0
      },
      "binding": {
        "Light": [
          "light"
        ]
      },
      "devices": {
        "lamp": {
          "category": [
            "Switch"
          ],
          "tags": [
            "Switch"
          ]
        },
        "light": {
