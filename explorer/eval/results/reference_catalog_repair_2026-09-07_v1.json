    "C03_002": {
      "before": {
        "index": "2",
        "index_old": "3.0",
        "category": "3.0",
        "category_v2": "C03",
        "command_kor": "클라우드 서비스가 활성화되어있으면, test.png 파일을 클라우드에 업로드해줘.",
        "command_eng": "If the cloud service is activated, upload test.png file to the cloud.",
        "ir_gt": "{\"timeline\": [{\"op\": \"start_at\", \"anchor\": \"now\"}, {\"op\": \"call\", \"target\": \"CloudServiceProvider.IsAvailable\", \"args\": {}, \"var\": \"IsAvailable\"}, {\"op\": \"if\", \"cond\": \"$IsAvailable == true\", \"then\": [{\"op\": \"call\", \"target\": \"CloudServiceProvider.UploadFile\", \"args\": {\"File\": \"test.png\"}}], \"else\": []}]}",
        "connected_devices": "{\"Main_CloudServiceProvider\": {\"category\": [\"CloudServiceProvider\"], \"tags\": [\"CloudServiceProvider\", \"Main\"]}, \"Backup_CloudServiceProvider\": {\"category\": [\"CloudServiceProvider\"], \"tags\": [\"CloudServiceProvider\", \"Backup\"]}}",
        "notes": "IsAvailable is defined as an action in 2.0.4 (not a value), but original GT reads it like a value; script preserved verbatim.",
        "has_else": "false",
        "binding_gt": "{\"CloudServiceProvider\": [\"Main_CloudServiceProvider\", \"Backup_CloudServiceProvider\"]}"
      },
      "after": {
        "index": "2",
        "index_old": "3.0",
        "category": "3.0",
        "category_v2": "C03",
        "command_kor": "메인 클라우드 서비스가 사용 가능하면, test.png 파일을 메인 클라우드에 업로드해줘.",
        "command_eng": "If the main cloud provider is available, upload test.png to the main cloud provider.",
        "ir_gt": "{\"timeline\": [{\"op\": \"start_at\", \"anchor\": \"now\"}, {\"op\": \"call\", \"target\": \"CloudServiceProvider.IsAvailable\", \"args\": {}, \"var\": \"IsAvailable\"}, {\"op\": \"if\", \"cond\": \"$IsAvailable == true\", \"then\": [{\"op\": \"call\", \"target\": \"CloudServiceProvider.UploadFile\", \"args\": {\"File\": \"test.png\"}}], \"else\": []}]}",
        "connected_devices": "{\"Main_CloudServiceProvider\": {\"category\": [\"CloudServiceProvider\"], \"tags\": [\"CloudServiceProvider\", \"Main\"]}, \"Backup_CloudServiceProvider\": {\"category\": [\"CloudServiceProvider\"], \"tags\": [\"CloudServiceProvider\", \"Backup\"]}}",
        "notes": "2026-09-07 user-approved contract: IsAvailable() is a no-argument BOOL read; check Main and upload only to Main. Backup remains connected.",
        "has_else": "false",
