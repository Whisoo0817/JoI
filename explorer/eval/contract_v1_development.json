          {
            "op": "start_at",
            "anchor": "now"
          },
          {
            "op": "delay",
            "duration": "150 MSEC"
          },
          {
            "op": "call",
            "target": "Switch.On"
          }
        ]
      },
      "binding": {
        "Switch": [
          "lamp"
        ]
      },
      "devices": {
        "lamp": {
          "category": [
            "Switch"
          ],
          "tags": [
            "Switch"
          ]
        }
      },
      "joi_block": {
        "script": "delay(150 MSEC)\n(#Switch).switch_on()",
        "period": 0
      },
      "input_domains": {},
