[
 {
  "id": "T01",
  "family": "sustain",
  "level": 1,
  "command": "If the front door stays open for 1 minute, announce 'Please close the front door' through the hallway speaker.",
  "spec": "Monitor the front door contact sensor from the start. When the door has been open continuously for 60 seconds, speak 'Please close the front door' once on the hallway speaker and then stop the automation for good. If the door closes before 60 seconds have elapsed, discard the elapsed time; timing starts again from zero the next time the door opens.",
  "devices": {
   "Front_Door": {
    "category": [
     "ContactSensor"
    ],
    "tags": [
     "Entrance",
     "Door",
     "ContactSensor"
    ]
   },
   "Hall_Speaker": {
    "category": [
     "Speaker"
    ],
    "tags": [
     "Hallway",
     "Speaker"
    ]
   }
  },
  "binding": {
   "ContactSensor": [
    "Front_Door"
   ],
   "Speaker": [
    "Hall_Speaker"
   ]
  },
  "selectors": {
   "ContactSensor.Contact": "(#Entrance #ContactSensor)",
   "Speaker.Speak": "(#Hallway #Speaker)"
  },
  "services": [
   "ContactSensor.Contact",
   "Speaker.Speak"
  ],
  "ir": {
   "timeline": [
    {
     "op": "start_at",
     "anchor": "now"
    },
    {
     "op": "wait",
     "cond": "ContactSensor.Contact == false",
     "edge": "none",
     "for": "1 MIN"
    },
    {
     "op": "call",
     "target": "Speaker.Speak",
     "args": {
      "Text": "Please close the front door"
     }
    }
   ]
  },
  "histories": [
   {
    "name": "open_and_stay",
    "kind": "nominal",
    "nl_determined": true,
    "horizon_ms": 240000,
    "events": [
     [
      0,
      {
       "Front_Door.Contact": true
      }
     ],
     [
      10000,
      {
       "Front_Door.Contact": false
      }
     ]
    ],
    "expected": [
     [
      70000,
      "Speaker.Speak",
      [
       "Please close the front door"
      ],
      "Hall_Speaker"
     ]
    ]
   },
   {
    "name": "closed_before_minute",
    "kind": "boundary",
    "nl_determined": true,
    "horizon_ms": 300000,
    "events": [
     [
      0,
      {
       "Front_Door.Contact": true
      }
     ],
     [
      10000,
      {
       "Front_Door.Contact": false
      }
     ],
     [
      50000,
      {
       "Front_Door.Contact": true
      }
     ],
     [
      55000,
      {
       "Front_Door.Contact": false
      }
     ]
    ],
    "expected": [
     [
      115000,
      "Speaker.Speak",
      [
       "Please close the front door"
      ],
      "Hall_Speaker"
     ]
    ]
   },
   {
    "name": "no_second_announcement",
    "kind": "boundary",
    "nl_determined": true,
    "horizon_ms": 300000,
    "events": [
     [
      0,
      {
       "Front_Door.Contact": true
      }
     ],
     [
      10000,
      {
       "Front_Door.Contact": false
      }
     ],
     [
      80000,
      {
       "Front_Door.Contact": true
      }
     ],
     [
      90000,
      {
       "Front_Door.Contact": false
      }
     ]
    ],
    "expected": [
     [
      70000,
      "Speaker.Speak",
      [
       "Please close the front door"
      ],
      "Hall_Speaker"
     ]
    ]
   }
  ]
 },
