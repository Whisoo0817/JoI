 {
  "id": "E1-099",
  "lang": "complete",
  "lang_reason": "E-STAMP + named counter: the deadline is t_on + 300 s + 120 s x (motions so far); the inner cycle's counter k counts motion iterations, so each motion extends the existing deadline instead of restarting a timer.",
  "stubs": [],
  "ir": {
   "timeline": [
    {
     "op": "start_at",
     "anchor": "now"
    },
    {
     "op": "cycle",
     "until": null,
     "period": "0 MSEC",
     "body": [
      {
       "op": "wait",
       "cond": "Switch.Switch == true",
       "edge": "rising"
      },
      {
       "op": "read",
       "var": "t_on",
       "src": "Clock.Timestamp"
      },
      {
       "op": "cycle",
       "until": null,
       "period": "0 MSEC",
       "count": "k",
       "body": [
        {
         "op": "wait",
         "cond": "MotionSensor.Motion == true or Clock.Timestamp >= $t_on + 300 + 120 * $k",
         "edge": "none"
        },
        {
         "op": "if",
         "cond": "Clock.Timestamp >= $t_on + 300 + 120 * $k",
         "then": [
          {
           "op": "if",
           "cond": "$t_m == null or Clock.Timestamp - $t_m >= 120",
           "then": [
            {
             "op": "call",
             "target": "Switch.Off",
             "args": {}
            }
           ]
          },
          {
           "op": "break"
          }
         ],
         "else": [
          {
           "op": "read",
           "var": "t_m",
           "src": "Clock.Timestamp"
          },
          {
           "op": "wait",
           "cond": "MotionSensor.Motion == false",
           "edge": "none"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
