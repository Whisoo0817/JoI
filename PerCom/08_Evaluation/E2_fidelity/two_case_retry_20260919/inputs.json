      "period": 1000,
      "script": "sum_ph := 0\nsum_cl := 0\ncount := 0\nlast_hour := -1\nh = (#Clock).Hour\nif (h >= 10 and h <= 14 and h != last_hour) {\n    sum_ph = sum_ph + (#Pool #PoolPH).Value\n    sum_cl = sum_cl + (#Pool #PoolChlorine).Value\n    count = count + 2\n    last_hour = h\n}\nif (h == 15 and count > 0) {\n    (#Report #Pool).ReportDailyQuality(sum_ph / count, sum_cl / count)\n    sum_ph = 0\n    sum_cl = 0\n    count = 0\n}"
    },
    "base_case": "E1-095",
    "automation": "main",
    "ir": {
      "timeline": [
        {
          "op": "start_at",
          "anchor": "now"
        },
        {
          "op": "cycle",
          "until": null,
          "period": "0 MSEC",
          "body": [
            {
              "op": "wait",
              "cond": "Clock.Hour == 10",
              "edge": "none"
            },
            {
              "op": "read",
              "var": "ph1",
              "src": "PoolPH[Pool_PH].Value"
            },
            {
              "op": "read",
              "var": "cl1",
              "src": "PoolChlorine[Pool_Chlorine].Value"
            },
            {
              "op": "delay",
              "duration": "1 HOUR"
            },
            {
              "op": "read",
              "var": "ph2",
              "src": "PoolPH[Pool_PH].Value"
            },
            {
              "op": "read",
              "var": "cl2",
              "src": "PoolChlorine[Pool_Chlorine].Value"
            },
            {
              "op": "delay",
              "duration": "1 HOUR"
            },
            {
              "op": "read",
              "var": "ph3",
              "src": "PoolPH[Pool_PH].Value"
            },
            {
              "op": "read",
              "var": "cl3",
              "src": "PoolChlorine[Pool_Chlorine].Value"
            },
            {
              "op": "delay",
              "duration": "1 HOUR"
            },
            {
              "op": "read",
              "var": "ph4",
              "src": "PoolPH[Pool_PH].Value"
            },
            {
              "op": "read",
              "var": "cl4",
              "src": "PoolChlorine[Pool_Chlorine].Value"
            },
            {
              "op": "delay",
              "duration": "1 HOUR"
            },
