{
  "_meta": {
    "schema": "adapt/effects v0",
    "catalog": "files/service_list_ver2.0.7.json",
    "authored": "2026-07-28",
    "why": [
      "The device catalog already carries types, units and enums. It does NOT carry the",
      "three axes a re-binding has to reason about, so this file adds exactly those:",
      "  1. effect direction  - which physical property a call moves, and which way",
      "  2. temporal class    - level vs pulse vs continuous vs one-shot",
      "  3. control mode      - setpoint vs on/off vs level (what the code may ask for)",
      "'essential' is deliberately NOT here: whether a role may be dropped is a property",
      "of the scenario's purpose, so it lives in the template's role contract."
    ],
    "temporal_classes": {
      "level": "sensor holds its value while the condition holds (presence, temperature)",
      "pulse": "sensor reports an instantaneous event; the value falls back on its own (motion)",
      "continuous": "actuator keeps acting until told otherwise (AC, humidifier)",
      "oneshot": "actuator performs a discrete act (toast, capture)"
    }
  },
  "AirConditioner": {
    "kind": "actuator",
    "control": "setpoint",
    "temporal": "continuous",
    "power": "switch",
    "affects": [
      {
        "property": "temperature",
        "direction": "down",
        "requires_mode": "cool",
        "closed_loop": true
      },
      {
        "property": "temperature",
        "direction": "up",
        "requires_mode": "heat",
        "closed_loop": true
      },
      {
        "property": "humidity",
        "direction": "down",
        "requires_mode": "cool",
        "incidental": true
      }
    ],
    "setpoint": {
      "member": "airconditioner.settargettemperature",
      "unit": "°C",
      "range": [
        16.0,
        30.0
      ]
    },
    "mode": {
      "member": "airconditioner.setairconditionermode",
      "enum": [
        "auto",
        "cool",
        "heat"
      ]
    }
  },
  "Fan": {
    "kind": "actuator",
    "control": "level",
    "temporal": "continuous",
    "power": "switch",
    "affects": [
      {
        "property": "perceived_temperature",
        "direction": "down",
        "closed_loop": false,
        "note": "airflow only; does not change measured room temperature"
      },
      {
        "property": "air_circulation",
        "direction": "up",
        "closed_loop": false
      }
    ],
    "setpoint": null,
    "mode": {
      "member": "fan.setfanmode",
      "enum": [
        "auto",
        "low",
        "medium",
        "high"
      ]
    }
  },
